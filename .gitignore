docs/data/*/meta.json
docs/data/*/catalogue.json
data/*/grids/season.npz

# Données de test simulées
docs/data/demo/
data/demo/
config/countries/demo.yml

__pycache__/
*.pyc
node_modules/

# Prévisions : recalculées toutes les 6 heures, non versionnées
data/*/grids/forecast.npz
data/*/grids/flood_forecast.npz
data/*/grids/flood_ensemble.npz
.venv/
data/*/external/desinventar.csv
data/*/reforecast/
data/*/c3s/
data/*/imerg/
data/*/drought/

